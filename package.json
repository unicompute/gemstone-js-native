{
  "name": "@gemstone-js/native",
  "version": "0.1.0-alpha.0",
  "description": "napi-rs native GCI bindings for gemstone-js.",
  "license": "MIT",
  "homepage": "https://github.com/unicompute/gemstone-js-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unicompute/gemstone-js-native.git"
  },
  "bugs": {
    "url": "https://github.com/unicompute/gemstone-js-native/issues"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "scripts/check-package.mjs",
    "scripts/smoke-node.mjs",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "cargo test",
    "test:node": "node scripts/smoke-node.mjs",
    "pack:check": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gemstone",
    "smalltalk",
    "gci",
    "napi-rs"
  ]
}
